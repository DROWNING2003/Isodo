#!/bin/sh
set -eu
mkdir -p /workspace/.isodo /workspace/.t3 /workspace/.codex /workspace/.home
chown -R 1000:1000 /workspace/.isodo /workspace/.t3 /workspace/.codex /workspace/.home
# The minimal initramfs does not bring up loopback; T3 binds 127.0.0.1.
ip link set lo up 2>/dev/null || /sbin/ip link set lo up 2>/dev/null || true
exec setpriv --reuid=1000 --regid=1000 --clear-groups --no-new-privs \
    env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/workspace/.home \
    T3CODE_HOME=/workspace/.t3 CODEX_HOME=/workspace/.codex T3CODE_SANDBOX=1 \
    /bin/sh -c 'cd /opt/isodo/t3 && exec /usr/local/bin/node bin.mjs serve --port 8080 --host 127.0.0.1 --base-dir /workspace/.t3 --mode web >>/workspace/.isodo/t3-server.log 2>&1'
