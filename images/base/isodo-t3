#!/bin/sh
set -eu
mkdir -p /workspace/.isodo /workspace/.t3 /workspace/.codex /workspace/.home
chown root:root /workspace/.isodo /workspace/.t3 /workspace/.codex /workspace/.home
echo $$ > /workspace/.isodo/t3.pid
# The minimal initramfs does not bring up loopback; T3 binds 127.0.0.1.
ip link set lo up 2>/dev/null || /sbin/ip link set lo up 2>/dev/null || true
exec setpriv --no-new-privs env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/workspace/.home USER=root \
    T3CODE_HOME=/workspace/.t3 CODEX_HOME=/workspace/.codex T3CODE_SANDBOX=1 \
    /bin/sh -c 'cd /opt/isodo/t3 && exec /usr/local/bin/node --env-file-if-exists=/workspace/.isodo/proxy.env bin.mjs serve --port 38080 --host 127.0.0.1 --base-dir /workspace/.t3 --mode web >>/workspace/.isodo/t3-server.log 2>&1'
