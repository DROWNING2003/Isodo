FROM golang:1.26.9-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/isodo-api ./cmd/isodo-api
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/isodo-api /usr/local/bin/isodo-api
ENTRYPOINT ["/usr/local/bin/isodo-api"]
