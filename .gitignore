# Product prototype remains local; the app client is part of the Isodo delivery.
/prototype/
/.tools/
/docs-site/node_modules/
/docs-site/.next/
/docs-site/.source/

# Local development artifacts
/artifacts/
node_modules/
dist/
.DS_Store
.env
certs/
.env.*
!.env.example

# Go build/test output
/bin/
/isodo-api
/isodo-node
/isodo-guest
/isodo-template
*.test
coverage.out

# Rendered local identity-provider configuration contains OAuth secrets.
/deploy/casdoor/*.runtime.json

# Rendered S3 credentials stay local.
/deploy/seaweedfs/*.runtime.json

# Guest binary is supplied to the isolated base-image build context.
/images/linux-base/isodo-guest

# Base image build context includes the T3 server bundle.
/images/base/t3-server-dist.bundle

# Isodo app build/runtime outputs (source remains tracked)
/app/artifacts/
/app/apps/desktop/dist-electron/
/app/apps/mobile/.expo/
/app/apps/mobile/ios/Pods/
/app/apps/mobile/ios/build/
/app/apps/mobile/android/.gradle/
/app/apps/mobile/android/app/build/
*.tsbuildinfo
.turbo/
.pnpm-store/
