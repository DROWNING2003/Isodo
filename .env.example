POSTGRES_USER=isodo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=isodo
CASDOOR_DATABASE=casdoor
POSTGRES_PORT=5432
REDIS_PORT=6379
ISODO_REDIS_URL=redis://127.0.0.1:6379/0
CASDOOR_PORT=8000
CASDOOR_ADMIN_PASSWORD=replace-with-a-local-password
CASDOOR_ORIGIN=http://localhost:8000
ISODO_CASDOOR_CLIENT_ID=isodo-local
ISODO_LISTEN_ADDR=127.0.0.1:8080
ISODO_CASDOOR_CLIENT_SECRET=replace-with-a-local-password
ISODO_WEB_ORIGIN=http://127.0.0.1:5734
ISODO_NODE_ID=
ISODO_NODE_LISTEN_ADDR=0.0.0.0:9090
ISODO_NODE_TLS_CERT=./certs/node.crt
ISODO_NODE_TLS_KEY=./certs/node.key
ISODO_NODE_CLIENT_CA=./certs/control-ca.crt
ISODO_CONTROL_CLIENT_URI=spiffe://isodo/control-worker
ISODO_NODE_RPC_TARGET=127.0.0.1:9090
ISODO_NODE_TLS_SERVER_NAME=isodo-node.local
ISODO_NODE_SERVER_CA=./certs/node-ca.crt
ISODO_CONTROL_TLS_CERT=./certs/control-worker.crt
ISODO_CONTROL_TLS_KEY=./certs/control-worker.key
ISODO_NODE_VERSION=0.1.0-dev
ISODO_CH_VERSION=
ISODO_CH_BINARY=cloud-hypervisor
# CHV defaults to /var/lib/isodo/node; Lima uses the user config directory.
ISODO_NODE_STATE_DIR=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible template artifact storage (SeaweedFS); make init generates local keys.
SEAWEEDFS_PORT=8333
SEAWEEDFS_ACCESS_KEY=replace-with-generated-storage-access-key
SEAWEEDFS_SECRET_KEY=replace-with-generated-storage-secret-key
SEAWEEDFS_READ_ACCESS_KEY=replace-with-generated-node-read-access-key
SEAWEEDFS_READ_SECRET_KEY=replace-with-generated-node-read-secret-key
ISODO_TEMPLATE_S3_ENDPOINT=http://127.0.0.1:8333
ISODO_TEMPLATE_S3_REGION=us-east-1
ISODO_TEMPLATE_S3_BUCKET=isodo-templates
